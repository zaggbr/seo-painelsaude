    {
      "parameters": {
        "jsCode": "// CORREÇÃO 1: Puxa o arquivo do nó específico do GitHub, não do nó anterior\nlet githubFile = {};\ntry {\n  githubFile = $('GitHub Get').first().json;\n} catch (e) {}\n\nconst conteudoBase64 = (githubFile.content || '').replace(/\\n/g, '');\n\nlet paginasAtuais = [];\nif (conteudoBase64) {\n  try {\n    const conteudoAtual = JSON.parse(Buffer.from(conteudoBase64, 'base64').toString('utf8'));\n    paginasAtuais = conteudoAtual.paginas || [];\n  } catch (e) {\n    console.error('Falha ao fazer parse do conteúdo atual do GitHub:', e);\n  }\n}\n\nconst validar = $('Validar resposta').first().json;\nconst novoConteudo = JSON.parse(validar.conteudo);\nconst paginasNovas = novoConteudo.paginas || [];\n\nconsole.log(`Páginas atuais: ${paginasAtuais.length} | Novas: ${paginasNovas.length}`);\n\n// CORREÇÃO 2: Faz um \"Upsert\" (se existir, atualiza; se não, insere)\nconst paginasMerge = [...paginasAtuais];\n\nfor (const p of paginasNovas) {\n  const index = paginasMerge.findIndex(old => old.slug === p.slug);\n  if (index !== -1) {\n    paginasMerge[index] = p; // Atualiza conteúdo antigo\n  } else {\n    paginasMerge.push(p); // Adiciona a nova página\n  }\n}\n\nconst resultado = {\n  _meta: {\n    geradoEm: new Date().toISOString(),\n    totalPaginas: paginasMerge.length,\n    silo: 'sus'\n  },\n  paginas: paginasMerge\n};\n\nreturn [{ json: {\n  conteudo: JSON.stringify(resultado, null, 2),\n  totalPaginas: paginasMerge.length\n}}];"
      },
