    {
      "parameters": {
        "jsCode": "// Lê blueprints aprovados do Google Sheets e deduplica por urlSatelite\nconst items = $input.all();\n\nlet rows = [];\ntry {\n  rows = items.map(i => i.json);\n} catch(e) {\n  rows = [];\n}\n\n// Blueprints fixos — páginas criadas manualmente que não devem sumir\nconst fixos = [\n  {\n    keyword: 'consultar fila sus',\n    slug: 'fila-sus',\n    url: '/sus/fila-sus/',\n    silo: 'sus',\n    tipo: 'guia',\n    volume: 12100\n  }\n];\n\n// Deduplica por urlSatelite, filtra aprovados e não publicados\nconst seen = new Set();\nconst blueprints = [];\n\n// Adiciona fixos primeiro\nfor (const f of fixos) {\n  seen.add(f.url);\n  blueprints.push(f);\n}\n\n// Adiciona do Sheets\nfor (const row of rows) {\n  const url = row.urlSatelite || row.url;\n  const status = (row.status || '').toLowerCase();\n  const publicado = (row.publicado || '').toString().toUpperCase();\n  \n  if (!url || status !== 'aprovado' || publicado === 'TRUE') continue;\n  if (seen.has(url)) continue;\n  seen.add(url);\n\n  blueprints.push({\n    keyword: row.keyword || '',\n    slug: url.replace(/^\\/sus\\//, '').replace(/\\/$/, ''),\n    url: url.endsWith('/') ? url : url + '/',\n    silo: row.nicho || 'sus',\n    tipo: row.tipo_ativo || 'guia',\n    volume: Number(row.volume) || 0,\n    titulo: row.titulo || '',\n    resumo: row.resumoBruto || ''\n  });\n}\n\nreturn [{ json: { blueprints, total: blueprints.length } }];"
      },
