    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst paginasNovas = input.dados?.paginas || [];\n\n// GitHub Get já executou antes — acessa pelo nome\nconst githubFile = $('GitHub Get').first().json;\nconst conteudoBase64 = (githubFile.content || '').replace(/\\n/g, '');\nlet paginasAtuais = [];\nif (conteudoBase64) {\n  const conteudoAtual = JSON.parse(Buffer.from(conteudoBase64, 'base64').toString('utf8'));\n  paginasAtuais = conteudoAtual.paginas || [];\n}\n\nconst slugsExistentes = new Set(paginasAtuais.map(p => p.slug));\nconst paginasMerge = [...paginasAtuais];\n\nfor (const p of paginasNovas) {\n  if (!slugsExistentes.has(p.slug)) {\n    paginasMerge.push(p);\n  }\n}\n\nconst resultado = {\n  _meta: {\n    geradoEm: new Date().toISOString(),\n    totalPaginas: paginasMerge.length,\n    silo: 'sus'\n  },\n  paginas: paginasMerge\n};\n\nreturn [{ json: {\n  conteudo: JSON.stringify(resultado, null, 2),\n  totalPaginas: paginasMerge.length\n}}];"
      },
