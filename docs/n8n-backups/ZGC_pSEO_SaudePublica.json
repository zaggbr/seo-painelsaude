      "parameters": {
        "jsCode": "// Formata os blueprints aprovados para passar ao workflow do feed\n// Este n\u00f3 \u00e9 o ponto de sa\u00edda que conecta ao ZGC_Feed_Editorial_Output\n\nconst blueprint = $input.first().json;\n\n// Formato exato que o workflow do feed espera\nreturn [{\n  json: {\n    keyword: blueprint.keyword,\n    titulo: blueprint.titulo,\n    urlSatelite: blueprint.urlSatelite,\n    nicho: blueprint.nicho,\n    resumoBruto: blueprint.resumoBruto,\n    tipoAtivo: blueprint.tipo_ativo,\n    volume: blueprint.volume,\n    score: blueprint.score_oportunidade\n  }\n}];"
