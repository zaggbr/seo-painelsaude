    {
      "parameters": {
        "method": "POST",
        "url": "=https://googleads.googleapis.com/v22/customers/{{ $json.customerId }}:generateKeywordIdeas",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleAdsOAuth2Api",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "developer-token",
              "value": "HNpTYmkziklnpzUlUZIRig"
            },
            {
              "name": "login-customer-id",
              "value": "8299916392"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"language\": \"languageConstants/1014\",\n  \"geoTargetConstants\": [\"geoTargetConstants/2076\"],\n  \"includeAdultKeywords\": false,\n  \"keywordSeed\": {\n    \"keywords\": [\"{{ $json.keyword }}\"]\n  },\n  \"historicalMetricsOptions\": {\n    \"includeAverageCpc\": true\n  }\n}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "68df33b9-1aed-4c4f-a47e-61ac122fdd76",
      "name": "Google Ads API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -480,
        208
      ],
      "executeOnce": true,
      "credentials": {
        "googleAdsOAuth2Api": {
          "id": "oKLyLoV6Olq93FKK",
          "name": "Keyword Google OAuth"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst vars = $('Wait').first().json;\n\nconst results = raw.results || [];\nif (results.length === 0) {\n  return [];\n}\n\nconst result = results[0];\nconst metrics = result.keywordIdeaMetrics || {};\n\nconst avgVolume = metrics.avgMonthlySearches ? parseInt(metrics.avgMonthlySearches) : 0;\nconst cpcMicros = metrics.averageCpcMicros ? parseInt(metrics.averageCpcMicros) : 0;\nconst cpcBRL = (cpcMicros / 1000000) * 5.0;\nconst competition = metrics.competition || 'UNKNOWN';\n\nconst monthlyVolumes = (metrics.monthlySearchVolumes || []).map(function(m) {\n  return parseInt(m.monthlySearches || 0);\n});\n\nlet sazonalidade = 0;\nlet quedaPct = 0;\n\nif (monthlyVolumes.length >= 4) {\n  const total = monthlyVolumes.reduce(function(a, b) { return a + b; }, 0);\n  const media = total / monthlyVolumes.length;\n  let maxV = monthlyVolumes[0];\n  let minV = monthlyVolumes[0];\n  for (let i = 1; i < monthlyVolumes.length; i++) {\n    if (monthlyVolumes[i] > maxV) { maxV = monthlyVolumes[i]; }\n    if (monthlyVolumes[i] < minV) { minV = monthlyVolumes[i]; }\n  }\n  sazonalidade = media > 0 ? (maxV - minV) / media : 0;\n\n  const recent = monthlyVolumes.slice(-3);\n  const previous = monthlyVolumes.slice(-6, -3);\n  if (previous.length === 3) {\n    const avgRecent = (recent[0] + recent[1] + recent[2]) / 3;\n    const avgPrevious = (previous[0] + previous[1] + previous[2]) / 3;\n    quedaPct = avgPrevious > 0 ? (avgPrevious - avgRecent) / avgPrevious : 0;\n  }\n}\n\nconst keywordText = result.text || vars.keyword;\n\nreturn [{\n  json: {\n    keyword: keywordText,\n    keyword_seed: vars.keyword,\n    nicho: vars.nicho,\n    nicho_label: vars.nicho_label,\n    site_url: vars.site_url,\n    volume: Number(avgVolume),\n    cpc_brl: Number(parseFloat(cpcBRL.toFixed(2))),\n    competition: String(competition),\n    sazonalidade: Number(parseFloat(sazonalidade.toFixed(3))),\n    queda_pct: Number(parseFloat(quedaPct.toFixed(3))),\n    monthly_volumes: monthlyVolumes,\n    volume_min: Number(vars.volume_min),\n    volume_max: Number(vars.volume_max),\n    queda_max: Number(vars.queda_max),\n    sazonalidade_max: Number(vars.sazonalidade_max)\n  }\n}];"
      },
