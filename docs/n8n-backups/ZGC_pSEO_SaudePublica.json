      "id": "7e14b415-ffd5-4601-a008-e080f39617cf",
      "name": "Serper: Busca SERP",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -16,
        48
      ]
    },
    {
      "parameters": {
        "jsCode": "const serperData = $input.first().json;\nconst kwData = $('Filtro SEO').first().json;\n\nconst organic = serperData.organic || [];\nconst paa = serperData.peopleAlsoAsk || [];\n\nconst serpSummary = organic.slice(0, 10).map(function(r, i) {\n  return (i+1) + '. ' + r.title + ' - ' + (r.snippet || '').replace(/\\n/g, ' ').substring(0, 100);\n}).join(' | ');\n\nconst paaSummary = paa.slice(0, 5).map(function(q) { return q.question; }).join('; ');\n\nconst payload = {\n  model: 'gpt-4o-mini',\n  temperature: 0.2,\n  response_format: { type: 'json_object' },\n  messages: [\n    {\n      role: 'system',\n      content: 'Analise resultados do Google e retorne JSON com: oportunidade (bool), score (0-10), tipo_ativo (calculadora/guia/simulador/comparador), razao (1 frase), url_satelite (/sus/slug/), titulo_sugerido (PT-BR), resumo_bruto (2 frases), concorrentes_fracos (array urls). Score 6+ se Top10 tem PDFs ou portais gov sem interatividade.'\n    },\n    {\n      role: 'user',\n      content: 'Keyword: ' + kwData.keyword + '\\nVolume: ' + kwData.volume + '/mes\\nTop10: ' + serpSummary + '\\nPAA: ' + paaSummary\n    }\n  ]\n};\n\nreturn [{\n  json: {\n    keyword: kwData.keyword,\n    volume: kwData.volume,\n    cpc_brl: kwData.cpc_brl,\n    competition: kwData.competition,\n    sazonalidade: kwData.sazonalidade,\n    queda_pct: kwData.queda_pct,\n    nicho: kwData.nicho,\n    nicho_label: kwData.nicho_label,\n    site_url: kwData.site_url,\n    volume_min: kwData.volume_min,\n    volume_max: kwData.volume_max,\n    queda_max: kwData.queda_max,\n    sazonalidade_max: kwData.sazonalidade_max,\n    serp_summary: serpSummary,\n    paa_questions: paaSummary,\n    openai_payload: JSON.stringify(payload)\n  }\n}];"
      },
