    {
      "parameters": {
        "jsCode": "// Monta o blueprint final a partir da an\u00e1lise da IA\n// Filtra apenas oportunidades com score >= 6\n\nconst raw = $input.first().json;\nconst kwData = $('Preparar Contexto SERP').first().json;\n\n// Extrai resposta da IA\nconst content = raw.choices?.[0]?.message?.content;\nif (!content) return [];\n\nlet analise;\ntry {\n  analise = JSON.parse(content);\n} catch(e) {\n  console.warn('JSON inv\u00e1lido da an\u00e1lise SERP:', e.message);\n  return [];\n}\n\n// Descarta se n\u00e3o for oportunidade ou score baixo\nif (!analise.oportunidade || (analise.score || 0) < 6) {\n  console.log(`Keyword descartada: ${kwData.keyword} (score: ${analise.score})`);\n  return [];\n}\n\nconst hoje = new Date().toISOString().split('T')[0];\n\n// Blueprint completo \u2014 contrato de dados para o workflow do feed\nconst blueprint = {\n  // Identifica\u00e7\u00e3o\n  data: hoje,\n  nicho: kwData.nicho,\n  nicho_label: kwData.nicho_label,\n  site_url: kwData.site_url,\n  \n  // Keyword validada\n  keyword: kwData.keyword,\n  keyword_seed: kwData.keyword_seed,\n  \n  // M\u00e9tricas Google Ads\n  volume: kwData.volume,\n  cpc_brl: kwData.cpc_brl,\n  competition: kwData.competition,\n  sazonalidade: kwData.sazonalidade,\n  queda_pct: kwData.queda_pct,\n  \n  // An\u00e1lise SERP\n  score_oportunidade: analise.score,\n  tipo_ativo: analise.tipo_ativo || 'guia',\n  razao_oportunidade: analise.razao,\n  concorrentes_fracos: analise.concorrentes_fracos || [],\n  \n  // Campos para o workflow de conte\u00fado\n  titulo: analise.titulo_sugerido,\n  urlSatelite: analise.url_satelite,\n  resumoBruto: analise.resumo_bruto,\n  \n  // Status\n  status: 'aprovado',\n  publicado: false\n};\n\nreturn [{ json: blueprint }];"
      },
