---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import responde from '../../data/responde.json';

const BASE = 'https://painelsaude.com.br';
const canonical = `${BASE}/responde/`;

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Painel Saúde Responde' },
];

const categories = [
  { label: 'Glossário ANS', color: '#1565c0', bg: '#e0f2fe' },
  { label: 'Direitos do Consumidor', color: '#7b3f00', bg: '#fef3c7' },
  { label: 'Guia de Contratação', color: '#14532d', bg: '#dcfce7' },
  { label: 'Regulação ANS 2026', color: '#581c87', bg: '#f3e8ff' },
];

const listSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Painel Saúde Responde",
  "description": "Guias e glossário sobre plano de saúde baseados nas normas da ANS",
  "itemListElement": responde.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.headline,
    "url": `${BASE}/responde/${item.slug}/`
  }))
};
---

<Layout
  title="Painel Saúde Responde: Guias e Glossário de Plano de Saúde ANS 2026"
  description="Respostas diretas sobre plano de saúde: carência, coparticipação, coberturas obrigatórias ANS, portabilidade, cancelamento e como reclamar. Baseado nas normas ANS 2026."
  canonical={canonical}
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />

  <style>
    .ps-responde-hub {
      max-width: 820px;
      margin: 0 auto;
      padding: 0 1rem 3rem;
      font-family: system-ui, -apple-system, sans-serif;
    }
    .ps-hub-header {
      text-align: center;
      padding: 1.5rem 0 2rem;
    }
    .ps-hub-eyebrow {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #1565c0;
      margin-bottom: 0.5rem;
    }
    h1 {
      font-size: clamp(1.6rem, 5vw, 2.4rem);
      font-weight: 800;
      color: #0d1b2a;
      margin: 0 0 0.75rem;
      line-height: 1.2;
    }
    .ps-hub-desc {
      color: #555;
      font-size: 1rem;
      max-width: 560px;
      margin: 0 auto;
      line-height: 1.6;
    }
    .ps-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1rem;
      margin-top: 2rem;
    }
    .ps-card {
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      transition: box-shadow 0.2s, border-color 0.2s;
      background: #fff;
    }
    .ps-card:hover {
      box-shadow: 0 4px 16px rgba(21,101,192,0.12);
      border-color: #93c5fd;
    }
    .ps-card-badge {
      display: inline-block;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 9999px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      width: fit-content;
    }
    .ps-card-title {
      font-size: 1rem;
      font-weight: 700;
      color: #0d1b2a;
      line-height: 1.3;
    }
    .ps-card-desc {
      font-size: 0.875rem;
      color: #666;
      line-height: 1.55;
    }
    .ps-card-cta {
      font-size: 0.8rem;
      font-weight: 600;
      color: #1565c0;
      margin-top: 0.25rem;
    }
    .ps-ans-strip {
      background: #f0f7ff;
      border: 1px solid #bfdbfe;
      border-radius: 10px;
      padding: 1rem 1.5rem;
      margin-top: 2.5rem;
      font-size: 0.88rem;
      color: #1e3a5f;
      text-align: center;
    }
    .ps-ans-strip a { color: #1565c0; }
    @media (max-width: 520px) {
      .ps-card-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="ps-responde-hub">
    <Breadcrumbs breadcrumbs={breadcrumbs} />

    <div class="ps-hub-header">
      <p class="ps-hub-eyebrow">Painel Saúde Responde</p>
      <h1>Guias e Glossário de Plano de Saúde</h1>
      <p class="ps-hub-desc">
        Respostas diretas sobre seus direitos no plano de saúde — baseadas nas normas da ANS 2026.
        Sem jargão desnecessário, sem viés comercial.
      </p>
    </div>

    <div class="ps-card-grid">
      {responde.map((item) => {
        const cat = categories.find(c => c.label === item.badge) || categories[0];
        return (
          <a href={`/responde/${item.slug}/`} class="ps-card">
            <span
              class="ps-card-badge"
              style={`background:${cat.bg};color:${cat.color}`}
            >
              {item.badge}
            </span>
            <div class="ps-card-title">{item.headline}</div>
            <div class="ps-card-desc">{item.description.slice(0, 110)}…</div>
            <div class="ps-card-cta">Ler guia →</div>
          </a>
        );
      })}
    </div>

    <div class="ps-ans-strip">
      Todas as informações são baseadas nas normas da ANS vigentes em 2026.
      Dúvidas? Acesse <a href="https://www.ans.gov.br" target="_blank" rel="noopener">ans.gov.br</a>
      ou ligue <strong>0800 701 9656</strong> (gratuito).
    </div>
  </div>
</Layout>
