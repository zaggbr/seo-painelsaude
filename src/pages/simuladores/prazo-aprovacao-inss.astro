        <ul class="space-y-2 text-sm" style="color:#005082;">
          <li><a href="https://painelsaude.com.br/simuladores/posso-me-aposentar" class="hover:text-blue-600">Simulador de Elegibilidade</a></li>
          <li><a href="https://painelsaude.com.br/simuladores/quanto-vou-receber-inss" class="hover:text-blue-600">Valor da Aposentadoria</a></li>
          <li><a href="https://meu.painelsaude.com.br/sus/fila-sus" class="hover:text-blue-600">Fila do SUS</a></li>
          <li><a href="https://painelsaude.com.br/planos" class="hover:text-blue-600">Planos de Saúde</a></li>
        </ul>
