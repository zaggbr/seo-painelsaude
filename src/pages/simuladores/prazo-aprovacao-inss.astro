  <div class="max-w-4xl mx-auto">
    <p class="mb-2">Prazos conforme IN PRES/INSS nº 128/2022 e Lei nº 9.784/1999. Informações de caráter exclusivamente informativo.</p>
    <p>© 2026 PainelSaúde — Informações de saúde pública para todos os brasileiros</p>
  </div>
</footer>

<script>
const CONF={
  aposentadoria:{dias:90,nome:'Aposentadoria',pagDias:30,etapas:[
    {n:'Protocolo e triagem',d:'INSS registra o pedido e verifica documentação básica'},
    {n:'Análise administrativa',d:'Verificação de requisitos: idade, contribuição, carência'},
    {n:'Cálculo do benefício',d:'Aplicação da fórmula pós-Reforma'},
    {n:'Concessão e carta',d:'Emissão da carta de concessão'},
    {n:'Primeiro pagamento',d:'Crédito em conta conforme calendário INSS'}
  ]},
  auxilio:{dias:45,nome:'Auxílio-doença',pagDias:15,etapas:[
    {n:'Protocolo e agendamento de perícia',d:'Agendamento varia por região e demanda'},
    {n:'Perícia médica',d:'Avaliação pelo médico perito do INSS'},
    {n:'Análise e concessão',d:'Validação de documentos e cálculo'},
    {n:'Primeiro pagamento',d:'Crédito em até 15 dias após concessão'}
  ]},
  bpc:{dias:90,nome:'BPC/LOAS',pagDias:30,etapas:[
    {n:'Protocolo no CRAS',d:'Entrega da documentação'},
    {n:'Avaliação social',d:'Verificação de renda familiar e CadÚnico'},
    {n:'Avaliação médica',d:'Perícia do INSS (se aplicável)'},
    {n:'Concessão',d:'Pagamento pelo Banco do Brasil no dia 1 do mês'}
  ]},
  pensao:{dias:30,nome:'Pensão por morte',pagDias:15,etapas:[
    {n:'Protocolo com certidão de óbito',d:'Documentos do falecido e dependentes'},
    {n:'Análise de dependência',d:'Verificação dos dependentes habilitados'},
    {n:'Concessão retroativa',d:'Data retroativa à data do óbito'}
  ]},
  salario:{dias:30,nome:'Salário-maternidade',pagDias:10,etapas:[
    {n:'Protocolo com documentação',d:'Certidão de nascimento ou atestado médico'},
    {n:'Análise de carência',d:'Verificação da qualidade de segurada'},
    {n:'Pagamento',d:'Mensal por 120 dias (ou 180 em casos especiais)'}
  ]}
};
function onTipo(){
  const t=document.getElementById('tipo').value;
  document.getElementById('row-recurso').style.display=['aposentadoria','bpc','auxilio'].includes(t)?'flex':'none';
}
function addDias(d,n){const r=new Date(d);r.setDate(r.getDate()+n);return r;}
function fmtD(d){return d.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric'});}
function calcular(){
  const tipo=document.getElementById('tipo').value;
  const dataStr=document.getElementById('data').value;
  const doc=document.getElementById('doc').checked;
  const recurso=document.getElementById('recurso').checked;
  if(!dataStr){alert('Informe a data do protocolo.');return;}
  const c=CONF[tipo];
  let dias=c.dias;
  if(!doc)dias+=30;
  if(recurso)dias+=180;
  const proto=new Date(dataStr+'T12:00:00');
  const limite=addDias(proto,dias);
  const pag=addDias(limite,c.pagDias);
  const hoje=new Date();
  const restam=Math.ceil((limite-hoje)/86400000);
  document.getElementById('resultado').style.display='block';
  document.getElementById('prazo-num').textContent=dias+' dias corridos';
  document.getElementById('prazo-label').textContent='prazo legal para '+c.nome;
  document.getElementById('data-limite').textContent=fmtD(limite);
  document.getElementById('data-pag').textContent=fmtD(pag);
  document.getElementById('data-dip').textContent=fmtD(proto);
  document.getElementById('juros').textContent=restam<0?'Sim — prazo vencido':'A partir de '+fmtD(limite);
  document.getElementById('etapas').innerHTML=c.etapas.map(e=>`<div class="flex gap-3 mb-3"><div class="etapa-dot mt-1"></div><div><div class="text-sm font-bold text-gray-800">${e.n}</div><div class="text-xs text-gray-500 mt-0.5">${e.d}</div></div></div>`).join('');
  const aviso=document.getElementById('aviso');
  if(restam<0){aviso.style.display='block';aviso.style.background='#fef2f2';aviso.style.border='1px solid #fca5a5';aviso.style.color='#dc2626';aviso.innerHTML=`<strong>⚠ Prazo legal vencido há ${Math.abs(restam)} dias.</strong> Você tem direito a juros de mora de 1% ao mês. Acesse o Meu INSS, registre reclamação na Ouvidoria (0800 780 0191) ou consulte um advogado previdenciário.`;}
  else if(restam<=15){aviso.style.display='block';aviso.style.background='#fffbeb';aviso.style.border='1px solid #fcd34d';aviso.style.color='#d97706';aviso.innerHTML=`<strong>⚠ Faltam apenas ${restam} dias.</strong> Acompanhe pelo Meu INSS ou ligue 135.`;}
  else{aviso.style.display='block';aviso.style.background='#e0f2fe';aviso.style.border='1px solid #bae6fd';aviso.style.color='#0077C0';aviso.innerHTML=`ℹ Faltam <strong>${restam} dias</strong> para o prazo legal. Acompanhe em meu.inss.gov.br ou pelo app INSS Digital.`;}
}
onTipo();
const hoje=new Date();document.getElementById('data').value=hoje.toISOString().split('T')[0];
async function loadRSS(){const c=document.getElementById('rss-posts');try{const r=await fetch('https://painelsaude.com.br/wp-json/wp/v2/posts?per_page=5&_fields=title,link,date',{signal:AbortSignal.timeout(4000)});if(!r.ok)throw new Error();const p=await r.json();c.innerHTML=p.map(x=>`<div class="rss-card"><a href="${x.link}" target="_blank" rel="noopener">${x.title.rendered}</a><div class="text-xs text-gray-400 mt-1">${new Date(x.date).toLocaleDateString('pt-BR')}</div></div>`).join('');}catch{c.innerHTML='<div class="rss-card"><a href="https://painelsaude.com.br" target="_blank" rel="noopener">Ver todos os artigos do PainelSaúde →</a></div>';}}
loadRSS();
</script>
</body>
</html>
