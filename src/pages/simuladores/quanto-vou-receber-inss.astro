<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Quanto vou receber do INSS? Simulador de Valor de Aposentadoria 2026</title>
  <meta name="description" content="Calcule o valor estimado da sua aposentadoria do INSS com a nova regra. Simulador atualizado com o teto de 2026."/>
  <meta name="robots" content="index, follow"/>
  <link rel="canonical" href="https://painelsaude.com.br/simuladores/quanto-vou-receber-inss"/>
  <meta property="og:title" content="Simulador de Valor da Aposentadoria INSS 2026"/>
  <meta property="og:site_name" content="PainelSaúde"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:#F2F2F2;}
    h1,h2,h3{color:#005082;}
    .zgc-btn{background:#0077C0;color:white;padding:12px 20px;border-radius:8px;border:none;width:100%;font-size:15px;font-weight:700;cursor:pointer;transition:background .2s;}
    .zgc-btn:hover{background:#005082;}
    select,input[type=number],input[type=date]{width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-family:'Inter',sans-serif;font-size:15px;background:white;outline:none;}
    select:focus,input:focus{border-color:#0077C0;}
    .card-resultado{background:white;border:2px solid #00A1E4;border-radius:8px;padding:20px;text-align:center;margin-bottom:12px;}
    .rss-card{background:white;border-radius:8px;padding:12px 16px;border-left:3px solid #00A1E4;margin-bottom:8px;}
    .rss-card a{color:#005082;text-decoration:none;font-weight:500;font-size:14px;}
  </style>
</head>
<body>
<header style="background:#1565c0;" class="text-white py-3 px-4">
  <div class="max-w-4xl mx-auto">
    <nav class="text-sm text-blue-200">
      <a href="https://painelsaude.com.br" class="hover:text-white">PainelSaúde</a>
      <span class="mx-2">›</span><a href="https://painelsaude.com.br/simuladores" class="hover:text-white">Simuladores</a>
      <span class="mx-2">›</span><span class="text-white">Valor da Aposentadoria</span>
    </nav>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-8">
  <div class="lg:grid lg:grid-cols-3 lg:gap-8">
    <div class="lg:col-span-2">
      <div class="inline-flex items-center gap-2 text-xs font-bold px-3 py-1 rounded-full mb-4" style="background:#e0f2fe;color:#0077C0;">
        💰 PainelSaúde · Simulador INSS 2026
      </div>
      <h1 class="text-3xl font-black mb-2">Quanto vou receber de Aposentadoria?</h1>
      <p class="text-gray-600 mb-6">Calcule o valor estimado da sua aposentadoria pelas regras de 2026 (Teto atualizado: R$ 8.475,55).</p>

      <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
        <h2 class="text-lg font-bold mb-4">Insira seus dados</h2>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Sexo</label>
            <select id="sexo">
              <option value="M">Masculino</option>
              <option value="F">Feminino</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Tempo de Contribuição (Anos)</label>
            <input type="number" id="anos" placeholder="Ex: 35" min="15" max="60">
          </div>
        </div>
        <div class="mb-5">
          <label class="block text-xs font-bold text-gray-600 mb-1">Sua Média Salarial (desde Julho/1994)</label>
          <div class="relative">
            <span class="absolute left-3 top-3 text-gray-500 font-bold">R$</span>
            <input type="number" id="media" class="pl-10" placeholder="3500" min="1412" step="100">
          </div>
          <p class="text-xs text-gray-400 mt-1">Dica: O valor da média pode ser encontrado no relatório do Meu INSS.</p>
        </div>
        
        <button class="zgc-btn" onclick="calcularValor()">Calcular Valor da Aposentadoria</button>
      </div>

      <div id="resultado" style="display:none" class="mb-6">
        <div class="card-resultado">
          <p class="text-sm font-bold text-gray-500 uppercase tracking-wide mb-1">Valor Estimado do Benefício</p>
          <h2 class="text-4xl font-black" style="color:#0077C0;" id="valor-final">R$ 0,00</h2>
          <p class="text-sm text-gray-600 mt-3" id="explicacao">Você receberá X% da sua média salarial.</p>
        </div>
      </div>

      <!-- SIMULE TAMBÉM -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-6 mt-6">
        <h2 class="text-lg font-bold mb-4">Simule também</h2>
        <div class="grid grid-cols-1 gap-3">
          <a href="https://painelsaude.com.br/simuladores/posso-me-aposentar" class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 hover:border-blue-400 transition-colors">
            <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background:#e0f2fe;"><span style="font-size:18px;">✅</span></div>
            <div><div class="text-sm font-bold" style="color:#005082;">Posso me aposentar?</div><div class="text-xs text-gray-500">Verifique elegibilidade nas 4 modalidades do INSS</div></div>
          </a>
          <a href="https://painelsaude.com.br/simuladores/prazo-aprovacao-inss" class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 hover:border-blue-400 transition-colors">
            <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background:#e0f2fe;"><span style="font-size:18px;">📅</span></div>
            <div><div class="text-sm font-bold" style="color:#005082;">Prazo de Aprovação</div><div class="text-xs text-gray-500">Veja quanto tempo o INSS tem para pagar</div></div>
          </a>
        </div>
      </div>
    </div>

    <!-- SIDEBAR -->
    <div class="lg:col-span-1 mt-8 lg:mt-0">
      <div class="bg-white rounded-lg shadow-sm p-5 mb-5 sticky top-4">
        <div class="text-xs font-black text-gray-400 uppercase tracking-widest mb-3">Descobrir mais</div>
        <ul class="space-y-2 text-sm" style="color:#005082;">
          <li><a href="https://painelsaude.com.br/simuladores/posso-me-aposentar" class="hover:text-blue-600">Simulador de Elegibilidade</a></li>
          <li><a href="https://painelsaude.com.br/simuladores/prazo-aprovacao-inss" class="hover:text-blue-600">Prazos de Pagamento INSS</a></li>
          <li><a href="https://meu.painelsaude.com.br/sus/fila-sus" class="hover:text-blue-600">Fila do SUS</a></li>
        </ul>
      </div>
    </div>
  </div>
</main>

<script>
function calcularValor() {
  const sexo = document.getElementById('sexo').value;
  const anos = parseInt(document.getElementById('anos').value) || 0;
  let media = parseFloat(document.getElementById('media').value) || 0;
  
  if (anos === 0 || media === 0) {
    alert('Por favor, preencha o tempo de contribuição e a média salarial.');
    return;
  }
  
  const TETO_INSS = 8475.55;
  const SALARIO_MINIMO = 1412.00;
  
  // A média não pode ultrapassar o teto
  if (media > TETO_INSS) {
    media = TETO_INSS;
  }

  // Regra base pós-reforma: 60% + 2% para cada ano que exceder 20 anos (Homem) ou 15 anos (Mulher)
  let percentual = 60;
  const limiteTempo = (sexo === 'M') ? 20 : 15;
  
  if (anos > limiteTempo) {
    percentual += (anos - limiteTempo) * 2;
  }
  
  if (percentual > 100) percentual = 100;
  
  let valorFinal = media * (percentual / 100);
  
  // Limites constitucionais
  if (valorFinal > TETO_INSS) valorFinal = TETO_INSS;
  if (valorFinal < SALARIO_MINIMO) valorFinal = SALARIO_MINIMO;
  
  // Renderizar
  document.getElementById('valor-final').textContent = valorFinal.toLocaleString('pt-BR', {style: 'currency', currency: 'BRL'});
  document.getElementById('explicacao').textContent = `Com ${anos} anos de contribuição, seu coeficiente é de ${percentual}% sobre sua média salarial. (Cálculo com base nas regras pós-Reforma da Previdência).`;
  
  document.getElementById('resultado').style.display = 'block';
}
</script>
</body>
</html>
