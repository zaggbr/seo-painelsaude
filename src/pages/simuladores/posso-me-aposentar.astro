<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Posso me Aposentar? Simulador de Elegibilidade INSS 2026</title>
  <meta name="description" content="Descubra se você já pode se aposentar pelo INSS. Simulador gratuito com as regras de 2026: Idade, Pontos, Idade Progressiva e Pedágio 100%."/>
  <meta name="robots" content="index, follow"/>
  <link rel="canonical" href="https://painelsaude.com.br/simuladores/posso-me-aposentar"/>
  <meta property="og:title" content="Simulador: Posso me Aposentar no INSS em 2026?"/>
  <meta property="og:site_name" content="PainelSaúde"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
  <style>
    body{font-family:'Inter',sans-serif;background:#F2F2F2;}
    h1,h2,h3{color:#005082;}
    .zgc-btn{background:#0077C0;color:white;padding:12px 20px;border-radius:8px;border:none;width:100%;font-size:15px;font-weight:700;cursor:pointer;transition:background .2s;}
    .zgc-btn:hover{background:#005082;}
    select,input[type=number],input[type=date]{width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:8px;font-family:'Inter',sans-serif;font-size:15px;background:white;outline:none;}
    select:focus,input:focus{border-color:#0077C0;}
    .card-regra{background:white;border:1px solid #e5e7eb;border-radius:8px;padding:16px;margin-bottom:12px;}
    .badge-ok{background:#dcfce7;color:#166534;padding:4px 8px;border-radius:9999px;font-size:12px;font-weight:700;display:inline-block;}
    .badge-wait{background:#fef9c3;color:#854d0e;padding:4px 8px;border-radius:9999px;font-size:12px;font-weight:700;display:inline-block;}
    .rss-card{background:white;border-radius:8px;padding:12px 16px;border-left:3px solid #00A1E4;margin-bottom:8px;}
    .rss-card a{color:#005082;text-decoration:none;font-weight:500;font-size:14px;}
  </style>
</head>
<body>
<header style="background:#1565c0;" class="text-white py-3 px-4">
  <div class="max-w-4xl mx-auto">
    <nav class="text-sm text-blue-200">
      <a href="https://painelsaude.com.br" class="hover:text-white">PainelSaúde</a>
      <span class="mx-2">›</span><a href="https://painelsaude.com.br/simuladores" class="hover:text-white">Simuladores</a>
      <span class="mx-2">›</span><span class="text-white">Posso me Aposentar?</span>
    </nav>
  </div>
</header>

<main class="max-w-4xl mx-auto px-4 py-8">
  <div class="lg:grid lg:grid-cols-3 lg:gap-8">
    <div class="lg:col-span-2">
      <div class="inline-flex items-center gap-2 text-xs font-bold px-3 py-1 rounded-full mb-4" style="background:#e0f2fe;color:#0077C0;">
        ✅ PainelSaúde · Simulador INSS 2026
      </div>
      <h1 class="text-3xl font-black mb-2">Posso me Aposentar?</h1>
      <p class="text-gray-600 mb-6">Descubra se você já atingiu os requisitos para se aposentar pelo INSS nas regras atualizadas.</p>

      <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
        <h2 class="text-lg font-bold mb-4">Seus Dados</h2>
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Sexo</label>
            <select id="sexo">
              <option value="M">Masculino</option>
              <option value="F">Feminino</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-600 mb-1">Data de Nascimento</label>
            <input type="date" id="nascimento">
          </div>
        </div>
        <div class="mb-4">
          <label class="block text-xs font-bold text-gray-600 mb-1">Tempo de Contribuição até Hoje</label>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <input type="number" id="anos" placeholder="Anos" min="0" max="60">
            </div>
            <div>
              <input type="number" id="meses" placeholder="Meses" min="0" max="11">
            </div>
          </div>
          <p class="text-xs text-gray-400 mt-1">Dica: Olhe o tempo total no seu CNIS (Meu INSS).</p>
        </div>
        <button class="zgc-btn" onclick="calcular()">Verificar Elegibilidade</button>
      </div>

      <div id="resultado" style="display:none">
        <h2 class="text-xl font-black mb-4">Resultado da Análise</h2>
        <div id="regras-container"></div>
      </div>

      <!-- SIMULE TAMBÉM -->
      <div class="bg-white rounded-lg shadow-sm p-6 mb-6 mt-6">
        <h2 class="text-lg font-bold mb-4">Simule também</h2>
        <div class="grid grid-cols-1 gap-3">
          <a href="https://painelsaude.com.br/simuladores/quanto-vou-receber-inss" class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 hover:border-blue-400 transition-colors">
            <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background:#e0f2fe;"><span style="font-size:18px;">💰</span></div>
            <div><div class="text-sm font-bold" style="color:#005082;">Quanto vou receber?</div><div class="text-xs text-gray-500">Calcule o valor estimado com fórmula INSS 2026</div></div>
          </a>
          <a href="https://painelsaude.com.br/simuladores/prazo-aprovacao-inss" class="flex items-center gap-3 p-4 rounded-lg border border-gray-200 hover:border-blue-400 transition-colors">
            <div class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0" style="background:#e0f2fe;"><span style="font-size:18px;">📅</span></div>
            <div><div class="text-sm font-bold" style="color:#005082;">Prazo de Aprovação</div><div class="text-xs text-gray-500">Veja quanto tempo o INSS tem para pagar</div></div>
          </a>
        </div>
      </div>
    </div>

    <!-- SIDEBAR -->
    <div class="lg:col-span-1 mt-8 lg:mt-0">
      <div class="bg-white rounded-lg shadow-sm p-5 mb-5 sticky top-4">
        <div class="text-xs font-black text-gray-400 uppercase tracking-widest mb-3">Descobrir mais</div>
        <ul class="space-y-2 text-sm" style="color:#005082;">
          <li><a href="https://painelsaude.com.br/simuladores/quanto-vou-receber-inss" class="hover:text-blue-600">Valor da Aposentadoria</a></li>
          <li><a href="https://painelsaude.com.br/simuladores/prazo-aprovacao-inss" class="hover:text-blue-600">Prazos de Pagamento INSS</a></li>
          <li><a href="https://meu.painelsaude.com.br/sus/fila-sus" class="hover:text-blue-600">Fila do SUS</a></li>
        </ul>
      </div>
    </div>
  </div>
</main>

<script>
function calcular() {
  const sexo = document.getElementById('sexo').value;
  const nascStr = document.getElementById('nascimento').value;
  const anosInput = parseInt(document.getElementById('anos').value) || 0;
  const mesesInput = parseInt(document.getElementById('meses').value) || 0;

  if(!nascStr) { alert('Informe a data de nascimento.'); return; }
  
  const nasc = new Date(nascStr + 'T12:00:00');
  const hoje = new Date();
  
  // Idade exata em anos fracionados
  const diffMs = hoje - nasc;
  const idadeAnos = diffMs / (1000 * 60 * 60 * 24 * 365.25);
  
  // Tempo de contribuição atual em anos fracionados
  const tempoContrib = anosInput + (mesesInput / 12);

  // Regras 2026
  const reqIdade = sexo === 'M' ? 65 : 62;
  const reqTempoIdade = sexo === 'M' ? 15 : 15; // Regra de transição da idade exige 15 anos para ambos se filiados antes da reforma
  
  const reqTempoMinimo = sexo === 'M' ? 35 : 30; // Para outras regras
  
  // Pontos 2026: Homem 103, Mulher 93
  const reqPontos = sexo === 'M' ? 103 : 93;
  const pontosAtuais = idadeAnos + tempoContrib;
  
  // Idade Progressiva 2026: Homem 64.5, Mulher 59.5
  const reqIdadeProg = sexo === 'M' ? 64.5 : 59.5;

  let html = '';
  
  // 1. Por Idade
  const idadeOk = idadeAnos >= reqIdade && tempoContrib >= reqTempoIdade;
  html += renderCard(
    'Aposentadoria por Idade',
    idadeOk,
    `Exige ${reqIdade} anos de idade e 15 anos de contribuição.`,
    `Você tem ${Math.floor(idadeAnos)} anos e ${tempoContrib.toFixed(1)} anos de contribuição.`
  );

  // 2. Pontos
  const pontosOk = pontosAtuais >= reqPontos && tempoContrib >= reqTempoMinimo;
  html += renderCard(
    'Regra dos Pontos',
    pontosOk,
    `Exige ${reqPontos} pontos (idade + contribuição) e ${reqTempoMinimo} anos de contribuição mínima em 2026.`,
    `Você tem ${Math.floor(pontosAtuais)} pontos e ${tempoContrib.toFixed(1)} anos de contribuição.`
  );
  
  // 3. Idade Progressiva
  const progOk = idadeAnos >= reqIdadeProg && tempoContrib >= reqTempoMinimo;
  html += renderCard(
    'Idade Mínima Progressiva',
    progOk,
    `Exige ${reqIdadeProg} anos de idade e ${reqTempoMinimo} anos de contribuição em 2026.`,
    `Você tem ${Math.floor(idadeAnos)} anos de idade e ${tempoContrib.toFixed(1)} anos de contribuição.`
  );

  document.getElementById('regras-container').innerHTML = html;
  document.getElementById('resultado').style.display = 'block';
}

function renderCard(titulo, ok, descricao, status) {
  const badge = ok 
    ? `<span class="badge-ok">✅ Atingiu os requisitos</span>` 
    : `<span class="badge-wait">⏳ Faltam requisitos</span>`;
    
  return `
    <div class="card-regra">
      <div class="flex justify-between items-start mb-2">
        <h3 class="font-bold text-lg text-gray-800">${titulo}</h3>
        ${badge}
      </div>
      <p class="text-sm text-gray-600 mb-1">${descricao}</p>
      <p class="text-sm font-medium text-gray-800">${status}</p>
    </div>
  `;
}
</script>
</body>
</html>
