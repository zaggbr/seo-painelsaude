---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { normalizarOperadora } from '../../../utils/normalizarOperadora.js';
import fs from 'node:fs';

export async function getStaticPaths() {
  const estados = JSON.parse(fs.readFileSync('./src/data/estados.json', 'utf-8'));
  return estados.map((estado) => ({
    params: { uf: estado.uf.toLowerCase() },
    props: { estado },
  }));
}

const { estado } = Astro.props;
const ano = new Date().getFullYear();
const BASE = 'https://painelsaude.com.br';
const canonical = `${BASE}/planos/estado/${estado.uf.toLowerCase()}/`;

const metaTitle = `Plano de Saúde em ${estado.nome}: ${estado.total_cidades} Cidades e Melhores Operadoras ${ano}`;
const metaDescription = `Compare as melhores operadoras de plano de saúde em ${estado.nome}. ${estado.total_cidades} cidades cobertas com dados ANS ${ano}: preços, coberturas e como escolher.`;

const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Planos de Saúde', url: '/planos/' },
  { name: estado.nome, url: `/planos/estado/${estado.uf.toLowerCase()}/` },
];

const modalidadeDesc: Record<string, string> = {
  'Medicina De Grupo': 'Rede própria de clínicas e hospitais',
  'Cooperativa Médica': 'Cooperativa de médicos — modelo Unimed',
  'Seguradora': 'Seguro saúde com reembolso ou rede credenciada',
  'Odontologia De Grupo': 'Plano exclusivo odontológico',
  'Autogestão': 'Plano administrado pela própria empresa beneficiária',
  'Filantropia': 'Entidade sem fins lucrativos',
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `Melhores Operadoras de Plano de Saúde em ${estado.nome}`,
    "description": metaDescription,
    "itemListElement": estado.top_operadoras.map((op: any, i: number) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": normalizarOperadora(op.nome),
      "url": `${BASE}/planos/operadora/${op.slug}/`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbs.map((b, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": b.name,
      "item": `${BASE}${b.url}`,
    })),
  },
];
---

<Layout title={metaTitle} description={metaDescription} canonical={canonical}>
  {jsonLd.map(ld => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

  <style>
    .ps-estado-wrap {
      max-width: 820px;
      margin: 0 auto;
      padding: 0 1rem 3rem;
      font-family: system-ui, -apple-system, sans-serif;
      color: #1a1a1a;
    }
    .ps-uf-badge {
      display: inline-block;
      background: #1565c0;
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 14px;
      border-radius: 9999px;
      margin-bottom: 0.75rem;
      letter-spacing: 0.06em;
    }
    h1 { font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 800; line-height: 1.2; margin: 0 0 0.5rem; color: #0d1b2a; }
    .ps-intro { color: #555; font-size: 1rem; line-height: 1.65; margin-bottom: 2rem; }
    h2 { font-size: 1.2rem; font-weight: 700; color: #0d1b2a; margin: 2rem 0 0.75rem; padding-bottom: 6px; border-bottom: 2px solid #e2e8f0; }
    /* Stats strip */
    .ps-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 0.75rem;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 1.25rem;
      margin-bottom: 2rem;
    }
    .ps-stat { text-align: center; }
    .ps-stat-n { font-size: 1.6rem; font-weight: 800; color: #1565c0; line-height: 1; }
    .ps-stat-l { font-size: 0.78rem; color: #666; margin-top: 4px; }
    /* Operadoras */
    .ps-op-grid { display: grid; gap: 0.65rem; }
    .ps-op-card {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 0.9rem 1.1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      text-decoration: none;
      color: #1a1a1a;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .ps-op-card:hover { border-color: #93c5fd; box-shadow: 0 2px 8px rgba(21,101,192,0.1); }
    .ps-op-rank { font-size: 0.75rem; font-weight: 700; color: #1565c0; width: 1.5rem; flex-shrink: 0; }
    .ps-op-name { font-weight: 600; font-size: 0.95rem; }
    .ps-op-mod { font-size: 0.78rem; color: #888; margin-top: 2px; }
    .ps-op-planos { font-size: 0.8rem; color: #1565c0; font-weight: 600; white-space: nowrap; }
    /* City grid */
    .ps-city-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.5rem;
      margin-top: 0.75rem;
    }
    .ps-city-link {
      border: 1px solid #e2e8f0;
      border-radius: 7px;
      padding: 0.65rem 0.9rem;
      text-decoration: none;
      color: #1a1a1a;
      font-size: 0.875rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: border-color 0.15s;
    }
    .ps-city-link:hover { border-color: #93c5fd; }
    .ps-city-ops { font-size: 0.75rem; color: #1565c0; font-weight: 600; }
    /* Values */
    .ps-values-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }
    .ps-value-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 0.9rem;
    }
    .ps-value-type { font-weight: 600; font-size: 0.9rem; }
    .ps-value-price { color: #1565c0; font-weight: 700; font-size: 1rem; margin: 4px 0; }
    .ps-value-note { font-size: 0.75rem; color: #888; }
    /* CTA */
    .ps-cta-strip {
      background: #1565c0;
      color: white;
      border-radius: 10px;
      padding: 1.5rem;
      text-align: center;
      margin: 2rem 0;
    }
    .ps-cta-strip h3 { font-size: 1.1rem; margin: 0 0 0.5rem; }
    .ps-cta-strip p { font-size: 0.88rem; opacity: 0.85; margin: 0 0 1rem; }
    .ps-cta-btn {
      display: inline-block;
      background: white;
      color: #1565c0;
      font-weight: 700;
      padding: 0.65rem 1.75rem;
      border-radius: 7px;
      text-decoration: none;
      font-size: 0.95rem;
    }
    /* Warning */
    .ps-warning {
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 8px;
      padding: 0.9rem 1.1rem;
      font-size: 0.85rem;
      color: #78350f;
      margin: 1.5rem 0;
    }
    @media (max-width: 500px) {
      .ps-values-grid { grid-template-columns: 1fr; }
      .ps-city-grid { grid-template-columns: 1fr; }
    }
  </style>

  <div class="ps-estado-wrap">
    <Breadcrumbs breadcrumbs={breadcrumbs} />

    <span class="ps-uf-badge">{estado.uf}</span>
    <h1>Plano de Saúde em {estado.nome}: Melhores Operadoras {ano}</h1>
    <p class="ps-intro">
      {estado.nome} tem <strong>{estado.total_cidades} cidades</strong> atendidas por operadoras registradas na ANS.
      Veja as principais operadoras disponíveis no estado, as cidades com maior oferta de planos e os valores de referência para {ano}.
    </p>

    <!-- Stats strip -->
    <div class="ps-stats">
      <div class="ps-stat">
        <div class="ps-stat-n">{estado.total_cidades}</div>
        <div class="ps-stat-l">Cidades cobertas</div>
      </div>
      <div class="ps-stat">
        <div class="ps-stat-n">{estado.top_operadoras.length}+</div>
        <div class="ps-stat-l">Principais operadoras</div>
      </div>
      <div class="ps-stat">
        <div class="ps-stat-n">ANS</div>
        <div class="ps-stat-l">Dados oficiais {ano}</div>
      </div>
    </div>

    <!-- Top operadoras -->
    <h2>Melhores Operadoras de Plano de Saúde em {estado.nome}</h2>
    <p style="font-size:0.88rem;color:#666;margin-bottom:1rem">
      Ranking por número de planos ativos — dados ANS {ano}. Mais planos indicam maior presença e rede credenciada mais ampla no estado.
    </p>
    <div class="ps-op-grid">
      {estado.top_operadoras.map((op: any, i: number) => (
        <a href={`/planos/operadora/${op.slug}/`} class="ps-op-card">
          <span class="ps-op-rank">#{i + 1}</span>
          <div style="flex:1;margin:0 1rem">
            <div class="ps-op-name">{normalizarOperadora(op.nome)}</div>
            <div class="ps-op-mod">{modalidadeDesc[op.modalidade] || op.modalidade}</div>
          </div>
          <span class="ps-op-planos">{op.total_planos.toLocaleString('pt-BR')} planos</span>
        </a>
      ))}
    </div>

    <!-- Valores de referência -->
    <h2>Valores de Referência em {estado.nome} ({ano})</h2>
    <div class="ps-values-grid">
      <div class="ps-value-card">
        <div class="ps-value-type">Plano Individual</div>
        <div class="ps-value-price">R$ 200 – R$ 900/mês</div>
        <div class="ps-value-note">Ambulatorial + hospitalar</div>
      </div>
      <div class="ps-value-card">
        <div class="ps-value-type">Plano Familiar</div>
        <div class="ps-value-price">R$ 600 – R$ 2.500/mês</div>
        <div class="ps-value-note">2 a 4 dependentes</div>
      </div>
      <div class="ps-value-card">
        <div class="ps-value-type">Coletivo Empresarial</div>
        <div class="ps-value-price">R$ 150 – R$ 600/mês</div>
        <div class="ps-value-note">Por beneficiário</div>
      </div>
      <div class="ps-value-card">
        <div class="ps-value-type">Plano Odontológico</div>
        <div class="ps-value-price">R$ 20 – R$ 100/mês</div>
        <div class="ps-value-note">Por pessoa</div>
      </div>
    </div>
    <p style="font-size:0.78rem;color:#999;margin-top:0.5rem">
      Valores estimados com base em dados ANS. Consulte a operadora para cotação exata na sua cidade.
    </p>

    <!-- Cidades do estado -->
    <h2>Cidades em {estado.nome} com maior oferta de planos</h2>
    <div class="ps-city-grid">
      {estado.top_cidades.map((c: any) => (
        <a href={`/planos/cidade/${c.slug}/`} class="ps-city-link">
          <span>{c.nome}</span>
          <span class="ps-city-ops">{c.total_operadoras} op.</span>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="ps-cta-strip">
      <h3>Encontre o plano certo para sua cidade</h3>
      <p>Veja todas as operadoras disponíveis no seu município com dados ANS {ano}</p>
      <a href="/planos/" class="ps-cta-btn">Ver Operadoras por Cidade →</a>
    </div>

    <!-- Como escolher -->
    <h2>Como escolher o melhor plano de saúde em {estado.nome}</h2>
    <p>
      Com {estado.total_cidades} cidades e dezenas de operadoras disponíveis no estado, a escolha do plano depende de três fatores principais:
    </p>
    <ol style="line-height:1.9;padding-left:1.25rem;color:#444">
      <li><strong>Sua cidade:</strong> nem toda operadora atende todas as cidades — verifique a rede credenciada na sua cidade antes de contratar.</li>
      <li><strong>Tipo de contratação:</strong> plano individual, coletivo empresarial (via empresa) ou coletivo por adesão (via sindicato/conselho profissional) têm preços e carências diferentes.</li>
      <li><strong>Segmentação:</strong> ambulatorial cobre consultas e exames; hospitalar cobre internações; a combinação dos dois oferece cobertura completa.</li>
    </ol>
    <p>
      Leia o guia completo: <a href="/responde/diferenca-ambulatorial-hospitalar-plano-de-saude/" style="color:#1565c0">Diferença entre plano ambulatorial e hospitalar</a>.
    </p>

    <div class="ps-warning">
      ⚠️ Dados fornecidos pela ANS. Disponibilidade de operadoras e preços variam por cidade e perfil do contratante. Consulte a operadora para cotação atualizada em {estado.nome}.
    </div>
  </div>
</Layout>
