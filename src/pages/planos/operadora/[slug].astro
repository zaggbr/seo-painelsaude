---
import Layout from '../../../layouts/Layout.astro';
import operadoras from '../../../data/operadoras.json';

export async function getStaticPaths() {
  return operadoras.slice(0, 200).map((op) => ({
    params: { slug: op.slug },
    props: { op },
  }));
}

const { op } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": op.nome,
  "description": `${op.nome} é uma operadora de planos de saúde registrada na ANS com ${op.total_planos} planos disponíveis.`,
  "url": `https://painelsaude.com.br/planos/operadora/${op.slug}`
};
---
<Layout
  title={`${op.nome} — Planos de Saúde | Painel Saúde`}
  description={`Conheça os planos de saúde da ${op.nome}. ${op.total_planos} planos disponíveis. Informações sobre cobertura, segmentação e contratação.`}
  canonical={`https://painelsaude.com.br/planos/operadora/${op.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav style="font-size:0.875rem;margin-bottom:1.5rem;color:#666">
    <a href="/">Início</a> › <a href="/planos">Planos de Saúde</a> › {op.nome}
  </nav>

  <article>
    <header style="margin-bottom:2rem">
      <span style="font-size:0.8rem;background:#e3f2fd;color:#1565c0;padding:0.25rem 0.75rem;border-radius:99px">
        {op.modalidade}
      </span>
      <h1 style="margin-top:0.75rem;font-size:1.75rem;line-height:1.3">{op.nome}</h1>
      <p style="color:#666;margin-top:0.5rem">Registro ANS: {op.registro_ans}</p>
    </header>

    {op.descricao && (
      <section style="margin-bottom:2rem;font-size:1rem;line-height:1.7;color:#444">
        <p>{op.descricao}</p>
      </section>
    )}

    <section style="background:#f8f9fa;border-radius:8px;padding:1.5rem;margin-bottom:2rem">
      <h2 style="font-size:1rem;margin-bottom:1rem;color:#333">Resumo da operadora</h2>
      <dl style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem">
        <dt style="color:#666;font-size:0.875rem">Total de planos ativos</dt>
        <dd style="font-weight:500">{op.total_planos}</dd>
        <dt style="color:#666;font-size:0.875rem">Modalidade</dt>
        <dd style="font-weight:500">{op.modalidade}</dd>
        <dt style="color:#666;font-size:0.875rem">Tipos de contratação</dt>
        <dd style="font-weight:500">{op.contratacoes.join(", ")}</dd>
        <dt style="color:#666;font-size:0.875rem">Abrangência</dt>
        <dd style="font-weight:500">{op.abrangencias.slice(0,2).join(", ")}</dd>
      </dl>
    </section>

    <section style="margin-bottom:2rem">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;color:#333">Tipos de cobertura disponíveis</h2>
      <ul style="display:flex;flex-wrap:wrap;gap:0.5rem;list-style:none">
        {op.segmentacoes.map((s) => (
          <li style="background:#e8f5e9;color:#2e7d32;padding:0.25rem 0.75rem;border-radius:99px;font-size:0.875rem">{s}</li>
        ))}
      </ul>
    </section>

    <section style="margin-bottom:2rem">
      <h2 style="font-size:1.2rem;margin-bottom:1rem;color:#333">Planos disponíveis</h2>
      <div style="display:grid;gap:1rem">
        {op.planos.slice(0, 10).map((plano) => (
          <div style="border:1px solid #e0e0e0;border-radius:8px;padding:1rem">
            <p style="font-weight:600;margin-bottom:0.5rem">{plano.nome}</p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.5rem;font-size:0.875rem;color:#666">
              <span>Cobertura: {plano.segmentacao}</span>
              <span>Contratação: {plano.contratacao}</span>
              <span>Abrangência: {plano.abrangencia}</span>
              <span>Acomodação: {plano.acomodacao}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section style="margin:2rem 0;text-align:center">
      <a href="/planos" style="display:inline-block;background:#1565c0;color:white;padding:0.75rem 2rem;border-radius:8px;text-decoration:none;font-weight:600;font-size:1rem">
        Ver Lista Completa de Planos de Saúde
      </a>
      <p style="margin-top:0.75rem;font-size:0.8rem;color:#888">
        Fonte oficial: <a href="https://www.ans.gov.br/planos-de-saude-e-operadoras" target="_blank" rel="noopener" style="color:#1565c0">ANS — Agência Nacional de Saúde Suplementar</a>
      </p>
    </section>

    <section style="background:#f0f7ff;border-radius:8px;padding:1.5rem;margin-bottom:2rem">
      <h2 style="font-size:1rem;margin-bottom:1rem;color:#1565c0">💰 Valores de Referência (2025)</h2>
      <p style="font-size:0.8rem;color:#888;margin-bottom:1rem">Faixas estimadas. Consulte seu corretor para valores exatos.</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:0.75rem;font-size:0.875rem">
        <div style="background:white;padding:0.75rem;border-radius:6px;border:1px solid #e0e0e0">
          <p style="font-weight:600;color:#333">Plano Individual</p>
          <p style="color:#1565c0;font-weight:700">R$ 200 – R$ 900/mês</p>
          <p style="color:#666;font-size:0.8rem">Cobertura ambulatorial e hospitalar</p>
        </div>
        <div style="background:white;padding:0.75rem;border-radius:6px;border:1px solid #e0e0e0">
          <p style="font-weight:600;color:#333">Plano Familiar</p>
          <p style="color:#1565c0;font-weight:700">R$ 600 – R$ 2.500/mês</p>
          <p style="color:#666;font-size:0.8rem">Para 2 a 4 dependentes</p>
        </div>
        <div style="background:white;padding:0.75rem;border-radius:6px;border:1px solid #e0e0e0">
          <p style="font-weight:600;color:#333">Plano Coletivo</p>
          <p style="color:#1565c0;font-weight:700">R$ 150 – R$ 600/mês</p>
          <p style="color:#666;font-size:0.8rem">Por beneficiário — empresas e associações</p>
        </div>
        <div style="background:white;padding:0.75rem;border-radius:6px;border:1px solid #e0e0e0">
          <p style="font-weight:600;color:#333">Plano Odontológico</p>
          <p style="color:#1565c0;font-weight:700">R$ 20 – R$ 100/mês</p>
          <p style="color:#666;font-size:0.8rem">Por pessoa</p>
        </div>
      </div>
    </section>

    <section style="background:#fafafa;border:1px solid #e8e8e8;border-radius:8px;padding:1.5rem;margin-bottom:2rem">
      <h2 style="font-size:1rem;margin-bottom:1rem;color:#333">📖 Glossário — Termos dos Planos de Saúde</h2>
      <dl style="font-size:0.875rem;display:grid;gap:0.75rem">
        <div><dt style="font-weight:600;color:#1565c0">Coparticipação</dt><dd style="color:#555;margin-top:0.2rem">Valor pago pelo beneficiário a cada uso do plano, além da mensalidade.</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">Carência</dt><dd style="color:#555;margin-top:0.2rem">Período inicial após a contratação em que determinadas coberturas ainda não estão disponíveis.</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">Segmentação assistencial</dt><dd style="color:#555;margin-top:0.2rem">Tipo de cobertura: ambulatorial, hospitalar, odontológico ou combinações.</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">Plano referência</dt><dd style="color:#555;margin-top:0.2rem">Cobertura mínima obrigatória definida pela ANS, incluindo internação e urgência.</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">Livre escolha</dt><dd style="color:#555;margin-top:0.2rem">Permite ao beneficiário escolher qualquer médico ou hospital, com reembolso posterior.</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">Acomodação</dt><dd style="color:#555;margin-top:0.2rem">Tipo de quarto em internação: enfermaria (coletivo) ou apartamento (individual).</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">Portabilidade</dt><dd style="color:#555;margin-top:0.2rem">Direito de trocar de operadora sem cumprir novas carências.</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">ROL ANS</dt><dd style="color:#555;margin-top:0.2rem">Lista de procedimentos e exames de cobertura obrigatória por todos os planos.</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">Abrangência</dt><dd style="color:#555;margin-top:0.2rem">Área geográfica onde o plano oferece cobertura: municipal, estadual, regional ou nacional.</dd></div>
        <div><dt style="font-weight:600;color:#1565c0">Fator moderador</dt><dd style="color:#555;margin-top:0.2rem">Mecanismo de regulação do uso: franquia, coparticipação ou desconto na mensalidade.</dd></div>
      </dl>
      <p style="margin-top:1rem;font-size:0.8rem;color:#888">
        Saiba mais: <a href="https://painelsaude.com.br/como-escolher-um-plano-de-saude-guia-completo" style="color:#1565c0">Como escolher um plano de saúde</a> · 
        <a href="https://painelsaude.com.br/plano-de-saude-familiar-guia-completo-para-famlia" style="color:#1565c0">Plano familiar</a> · 
        <a href="https://painelsaude.com.br/plano-de-saude-empresarial-vantagens-regras-ans" style="color:#1565c0">Plano empresarial</a>
      </p>
    </section>

    <section style="background:#fff8e1;border-left:3px solid #f9a825;padding:1rem 1.25rem;border-radius:4px;margin-bottom:2rem">
      <p style="font-weight:600;color:#e65100;margin-bottom:0.25rem">⚠️ Informação importante</p>
      <p style="font-size:0.9rem;color:#444">Os dados são fornecidos pela ANS e podem não refletir os preços atuais. Entre em contato diretamente com a operadora para cotação atualizada.</p>
    </section>
  </article>
</Layout>