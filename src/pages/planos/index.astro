---
import Layout from '../../layouts/Layout.astro';
import operadoras from '../../data/operadoras.json';

const top = operadoras.slice(0, 200);
const modalidades = [...new Set(top.map(op => op.modalidade))];

import Breadcrumbs from '../../components/Breadcrumbs.astro';
const breadcrumbs = [
  { name: 'Início', url: '/' },
  { name: 'Planos de Saúde', url: '/planos' }
];
---
<Layout
  title="Planos de Saúde no Brasil | Painel Saúde"
  description="Compare planos de saúde de 200 operadoras registradas na ANS. Informações sobre cobertura, contratação e abrangência."
  canonical="https://painelsaude.com.br/planos"
  breadcrumbs={breadcrumbs}
>
  <Breadcrumbs breadcrumbs={breadcrumbs} />
  <header style="margin-bottom:2rem">
    <h1 style="font-size:1.75rem;line-height:1.3;margin-bottom:0.75rem">Planos de Saúde no Brasil</h1>
    <p style="color:#555;font-size:1.05rem">{top.length} operadoras registradas na ANS — dados oficiais atualizados.</p>
  </header>

  {modalidades.map(mod => (
    <>
      {mod === 'Cooperativa Médica' && (
        <div id="zgc-relacionados" data-pools="guia-planos-saude" data-qtd="8" data-modo="aleatorio"></div>
        <script src="https://zgc-widgets.pages.dev/widgets/conteudo-relacionado.js" defer></script>
      )}
      <section style="margin-bottom:2.5rem">
        <h2 style="font-size:1.1rem;font-weight:600;color:#1565c0;border-bottom:2px solid #e3f2fd;padding-bottom:0.5rem;margin-bottom:1rem">
          {mod}
        </h2>
        <ul style="list-style:none;display:grid;gap:0.5rem">
          {top.filter(op => op.modalidade === mod).map(op => (
            <li style="border:1px solid #e8e8e8;border-radius:8px;overflow:hidden">
              <a href={`/planos/operadora/${op.slug}`} style="display:flex;justify-content:space-between;align-items:center;padding:0.75rem 1rem;text-decoration:none;color:#333">
                <span style="font-weight:500">{op.nome}</span>
                <span style="font-size:0.8rem;color:#666">{op.total_planos} planos</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </>
  ))}
</Layout>