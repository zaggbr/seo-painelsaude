---
import CookieBanner from "../components/CookieBanner.astro";
import { extractFromContent } from "../utils/seo.js";
import { Image } from "astro:assets";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogImage?: string;
  type?: string;
  excerpt?: string;
  content?: string;
}
const { title, description, canonical, image, ogImage: propOgImage, type, excerpt, content } = Astro.props;

const baseTitle = title || "Painel Saúde";
const siteName = "Painel Saúde";
const pageTitle = baseTitle.length > 50 
  ? baseTitle 
  : `${baseTitle} | ${siteName}`;

const metaDescription = description || excerpt || extractFromContent(content || '', 160) || "";
const canonicalURL = canonical || new URL(Astro.url.pathname, 'https://painelsaude.com.br').toString();

const ogImage = image || propOgImage || "https://painelsaude.com.br/wp-content/uploads/2025/05/painel-saude-logo-1.png";
const ogType = type === 'article' ? 'article' : 'website';
---
<!DOCTYPE html>
<html lang="pt-BR" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={baseTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={baseTitle} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@painelsaude" />
    <meta name="twitter:creator" content="@painelsaude" />

    <!-- Performance: Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" />

    <link rel="icon" type="image/x-icon" href="https://seo-painelsaude.pages.dev/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://seo-painelsaude.pages.dev/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://seo-painelsaude.pages.dev/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://seo-painelsaude.pages.dev/apple-touch-icon.png" />
    <link rel="manifest" href="https://seo-painelsaude.pages.dev/site.webmanifest" />
    <meta name="theme-color" content="#1565c0" />

    <!--
      Removido: script AdSense da Educta (ca-pub-6423824976813529) que
      estava carregado aqui por engano — não tem nada a ver com este site.
    -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6307491010120109" crossorigin="anonymous"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; color: #1a1a1a; line-height: 1.6; font-display: swap; }
      main { max-width: 860px; margin: 0 auto; padding: 2rem 1rem; }
      a { color: #0066cc; }
      header.site-header {
        padding: 1.1rem 1rem;
        text-align: center;
        border-bottom: 1px solid #e2e8f0;
      }
      header.site-header a { display: inline-block; }
      header.site-header img { height: 46px; width: auto; display: block; }
      footer { background: #f5f5f5; text-align: center; padding: 2rem; margin-top: 3rem; font-size: 0.875rem; color: #666; }
      footer .ps-disclaimer { max-width: 640px; margin: 0 auto 1rem; color: #777; font-size: 0.78rem; line-height: 1.6; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a href="/">
        <Image 
          src="https://seo-painelsaude.pages.dev/painelsaude-logo-horizontal.png" 
          alt="Painel Saúde" 
          width={200} 
          height={46} 
          format="webp" 
          quality={80} 
          loading="eager" 
          fetchpriority="high"
          inferSize={true}
        />
      </a>
    </header>
    <div style="text-align:center;margin:1rem 0">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-6307491010120109"
           data-ad-slot="6730056304"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
    <main>
      <slot />
    </main>
    <div style="text-align:center;margin:2rem 0 1rem">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-6307491010120109"
           data-ad-slot="6730056304"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
      <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
    </div>
    <footer>
      <p class="ps-disclaimer">As informações deste site foram compiladas a partir de dados públicos compartilhados por órgãos governamentais brasileiros (Ministério da Saúde, ANVISA, INSS, entre outros) e têm caráter exclusivamente informativo, não substituindo orientação médica, farmacêutica ou jurídica profissional.</p>
      <p>© 2026 Painel Saúde — Informações de saúde pública para todos os brasileiros</p>
    </footer>
    <CookieBanner />
  </body>
</html>
