---
import CookieBanner from "../components/CookieBanner.astro";
import { extractFromContent } from "../utils/seo.js";
import { Image } from "astro:assets";
import Schema from "../components/Schema.astro";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  ogImage?: string;
  type?: string;
  excerpt?: string;
  content?: string;
  breadcrumbs?: { name: string; item: string }[];
}
const { title, description, canonical, image, ogImage: propOgImage, type, excerpt, content, breadcrumbs } = Astro.props;

const baseTitle = title || "Painel Saúde";
const siteName = "Painel Saúde";
const pageTitle = baseTitle.length > 50 
  ? baseTitle 
  : `${baseTitle} | ${siteName}`;

const metaDescription = description || excerpt || extractFromContent(content || '', 160) || "";
const canonicalURL = canonical || new URL(Astro.url.pathname, 'https://painelsaude.com.br').toString();

const ogImage = image || propOgImage || "https://painelsaude.com.br/wp-content/uploads/2025/05/painel-saude-logo-1.png";
const ogType = type === 'article' ? 'article' : 'website';
---
<!DOCTYPE html>
<html lang="pt-BR" dir="ltr">
  <head>
<link rel="icon" type="image/png" sizes="32x32" href="https://painelsaude.com.br/wp-content/uploads/2026/07/painelsaude-logo-icone-so.png">
<link rel="apple-touch-icon" href="https://painelsaude.com.br/wp-content/uploads/2026/07/painelsaude-logo-icone-so.png">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{pageTitle}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph -->
    <meta property="og:title" content={baseTitle} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={baseTitle} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@painelsaude" />
    <meta name="twitter:creator" content="@painelsaude" />

    <!-- Schema.org JSON-LD -->
    <Schema breadcrumbs={breadcrumbs} />

    <!-- Performance: Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" />

    <link rel="icon" type="image/x-icon" href="https://seo-painelsaude.pages.dev/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="https://seo-painelsaude.pages.dev/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="https://seo-painelsaude.pages.dev/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="https://seo-painelsaude.pages.dev/apple-touch-icon.png" />
    <link rel="manifest" href="https://seo-painelsaude.pages.dev/site.webmanifest" />
    <meta name="theme-color" content="#1565c0" />

    <!--
      Removido: script AdSense da Educta (ca-pub-6423824976813529) que
      estava carregado aqui por engano — não tem nada a ver com este site.
    -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6307491010120109" crossorigin="anonymous"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: system-ui, sans-serif; color: #1a1a1a; line-height: 1.6; font-display: swap; }
      main { max-width: 860px; margin: 0 auto; padding: 2rem 1rem; }
      a { color: #0066cc; }
      header.site-header {
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        padding: 0;
      }
      .header-inner {
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem;
        flex-wrap: wrap;
        gap: 1rem;
      }
      header.site-header img { height: 46px; width: auto; display: block; }
      .main-nav {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
      }
      .main-nav a {
        color: #333;
        text-decoration: none;
        font-weight: 500;
        font-size: 0.95rem;
      }
      .main-nav a:hover { color: #1565c0; }
      footer { background: #f5f5f5; padding: 3rem 1rem; margin-top: 3rem; font-size: 0.875rem; color: #666; }
      .footer-inner {
        max-width: 1000px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 2rem;
        margin-bottom: 2rem;
        text-align: left;
      }
      .footer-col h3 { color: #333; font-size: 1rem; margin-bottom: 1rem; }
      .footer-col ul { list-style: none; }
      .footer-col li { margin-bottom: 0.5rem; }
      .footer-col a { color: #555; text-decoration: none; }
      .footer-col a:hover { color: #1565c0; }
      .footer-bottom { text-align: center; border-top: 1px solid #ddd; padding-top: 2rem; }
      footer .ps-disclaimer { max-width: 800px; margin: 0 auto 1rem; color: #777; font-size: 0.78rem; line-height: 1.6; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/">
          <Image 
            src="https://seo-painelsaude.pages.dev/painelsaude-logo-horizontal.png" 
            alt="Painel Saúde" 
            width={200} 
            height={46} 
            format="webp" 
            quality={80} 
            loading="eager" 
            fetchpriority="high"
            inferSize={true}
          />
        </a>
        <nav class="main-nav">
          <a href="https://painelsaude.com.br/">Home</a>
          <a href="https://painelsaude.com.br/planos/">Planos</a>
          <a href="https://painelsaude.com.br/sus/">SUS</a>
          <a href="https://painelsaude.com.br/noticias/">Notícias</a>
          <a href="https://painelsaude.com.br/ciencia/">Ciência</a>
          <a href="https://painelsaude.com.br/bula/">Bulas</a>
          <a href="https://painelsaude.com.br/webstories/">Stories</a>
        </nav>
      </div>
    </header>
    
    <main>
      <slot />
    </main>
    
    <footer>
      <div class="footer-inner">
        <div class="footer-col">
          <h3>Categorias Principais</h3>
          <ul>
            <li><a href="https://painelsaude.com.br/planos/">Planos de Saúde</a></li>
            <li><a href="https://painelsaude.com.br/sus/">Tudo sobre o SUS</a></li>
            <li><a href="https://painelsaude.com.br/ciencia/">Ciência e Estudos</a></li>
            <li><a href="https://painelsaude.com.br/noticias/">Notícias do Setor</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3>Páginas Úteis</h3>
          <ul>
            <li><a href="https://painelsaude.com.br/glossario/">Glossário Médico</a></li>
            <li><a href="https://painelsaude.com.br/bula/">Bulas de Remédios</a></li>
            <li><a href="https://painelsaude.com.br/simuladores/posso-me-aposentar">Posso me Aposentar?</a></li>
            <li><a href="https://painelsaude.com.br/simuladores/quanto-vou-receber-inss">Valor da Aposentadoria</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h3>Painel Saúde</h3>
          <ul>
            <li><a href="https://painelsaude.com.br/quem-somos-painel-saude/">Sobre Nós</a></li>
            <li><a href="https://painelsaude.com.br/contato/">Contato</a></li>
            <li><a href="https://painelsaude.com.br/politica-de-privacidade/">Privacidade</a></li>
            <li><a href="https://painelsaude.com.br/termos-e-condicoes-de-uso/">Termos de Uso</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <p class="ps-disclaimer">As informações deste site foram compiladas a partir de dados públicos compartilhados por órgãos governamentais brasileiros (Ministério da Saúde, ANVISA, INSS, entre outros) e têm caráter exclusivamente informativo, não substituindo orientação médica, farmacêutica ou jurídica profissional.</p>
        <p>© 2026 Painel Saúde — Informações de saúde pública para todos os brasileiros</p>
      </div>
    </footer>
    <CookieBanner />
  </body>
</html>
